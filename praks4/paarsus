#!/bin/bash
# Skript, mis kontrollib kasutaja poolt sisestatud käsureaparameetrina täisarvu paaris või mitte

if [ $# -ne 1 ]; then
	echo "Käivita see skript koos arvuga mille paaris/paaritu soovid kontrollida. Näiteks: $0 3"
else
	arv=$1
	jaak=$(( $arv % 2 ))
	if [ $jaak -eq 0 ]; then
		echo "$arv on paaris"
	else
		echo "$arv on paaritu"
	fi
fi
